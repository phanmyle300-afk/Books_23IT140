<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản Lý Sách - {{mssv}}</title>
    <!-- Nhúng Bootstrap 5 CDN để làm đẹp giao diện -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container py-5">
        <!-- Tiêu đề trang -->
        <div class="text-center mb-5">
            <h1 class="text-primary fw-bold">📚 Hệ Thống Quản Lý Sách Trên Mây</h1>
            <p class="text-muted">Đám mây phân tán - MongoDB Atlas Multi-Connection & Stateless Session</p>
        </div>

        <!-- Form Thêm Mới Sách -->
        <div class="card shadow-sm mb-5 border-0">
            <div class="card-header bg-primary text-white fw-semibold py-3">
                ➕ Thêm Sách Mới (Sử dụng Tài khoản Ghi)
            </div>
            <div class="card-body bg-white">
                <form action="/books/add" method="POST" class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Mã sản phẩm:</label>
                        <input type="text" name="productId" class="form-control" placeholder="Bắt đầu bằng 140..." required>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Tên sách:</label>
                        <input type="text" name="name" class="form-control" placeholder="Nhập tên sách..." required>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Giá trước thuế (VNĐ):</label>
                        <input type="number" name="priceBeforeTax" class="form-control" placeholder="Ví dụ: 150000" required>
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-success w-100 fw-semibold">Lưu Sách</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Bảng Hiển Thị Danh Sách Sách -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white fw-semibold py-3 d-flex justify-content-between align-items-center">
                <span>📖 Danh Sách Sách Hiện Có (Sử dụng Tài khoản Đọc)</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0 align-middle text-center">
                        <thead class="table-secondary">
                            <tr>
                                <th>Mã SP</th>
                                <th class="text-start">Tên Sách</th>
                                <th>Giá Trước Thuế</th>
                                <th>Giá Sau Thuế (VAT {{vatPercent}})</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each books}}
                            <tr>
                                <td><span class="badge bg-info text-dark px-3 py-2">{{this.productId}}</span></td>
                                <td class="text-start fw-semibold text-dark">{{this.name}}</td>
                                <td>{{this.priceBeforeTax}} VNĐ</td>
                                <td class="text-danger fw-bold">{{this.priceAfterTax}} VNĐ</td>
                            </tr>
                            {{else}}
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">Chưa có dữ liệu sách nào trong cơ sở dữ liệu.</td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Footer bắt buộc theo yêu cầu đồ án -->
        <footer class="text-center mt-5 pt-4 border-top text-secondary">
            <p class="mb-1">Họ và tên sinh viên: <strong class="text-dark">{{fullName}}</strong> | Mã số sinh viên (MSSV): <strong class="text-dark">{{mssv}}</strong></p>
            <p class="mb-0">Thuế suất VAT cấu hình: <span class="badge bg-warning text-dark px-2 py-1">{{vatPercent}}</span></p>
        </footer>
    </div>
</body>
</html>